@page
@{ ViewData["Title"] = "Configuration"; }

<div class="card">
    <span class="eyebrow">07 SETTINGS</span>
    <h2>Environment Configuration</h2>
    <p class="supporting-text">Sanitized view of Active Lab Environments. Credentials are masked for security.</p>
    
    <div id="configContent" style="padding:16px 0;">
        Loading configuration...
    </div>
</div>

<script>
async function loadConfig() {
    try {
        const res = await fetch('/api/config');
        const data = await res.json();
        document.getElementById('configContent').innerHTML = renderBeautifulResult(data);
    } catch(e) {
        document.getElementById('configContent').textContent = 'Error loading configuration: ' + e.message;
    }
}
window.onload = loadConfig;
</script>
