@page
@{ ViewData["Title"] = "File Encryption"; }

<div class="card">
    <span class="eyebrow">FILE</span>
    <h2>File Encryption</h2>
    <div style="display: grid; gap: 16px;">
        <div>
            <label><strong>File:</strong></label><br/>
            <input type="file" id="fileInput" style="padding:8px;" />
        </div>
        <div style="display: flex; gap: 16px;">
            <div style="flex:1;">
                <label><strong>Key Identifier:</strong></label><br/>
                <input type="text" id="fileKeyId" placeholder="e.g. test-key-1" style="width:100%; padding:8px; box-sizing:border-box;" />
            </div>
            <div style="flex:1;">
                <label><strong>Algorithm:</strong></label><br/>
                <select id="fileAlgorithm" style="width:100%; padding:8px; box-sizing:border-box;">
                    <option value="AES">AES</option>
                    <option value="AES-CBC">AES-CBC</option>
                    <option value="AES-GCM">AES-GCM</option>
                </select>
            </div>
        </div>
        <div style="display: flex; gap: 8px;">
            <button class="btn" onclick="doFileOp('encrypt')">Encrypt</button>
            <button class="btn" onclick="doFileOp('decrypt')">Decrypt</button>
        </div>
        <div id="fileStatus" style="padding:8px; display:none;"></div>
        <div>
            <label><strong>Result:</strong></label>
            <div id="fileResult" style="padding:16px 0; min-height:60px;"></div>
        </div>
    </div>
</div>

<script>
async function doFileOp(action) {
    const statusEl = document.getElementById('fileStatus');
    const resultEl = document.getElementById('fileResult');
    const fileInput = document.getElementById('fileInput');
    statusEl.style.display = 'block';
    statusEl.style.background = '#f39c12'; statusEl.style.color = 'white';
    statusEl.textContent = 'In Progress...';

    if (!fileInput.files.length) {
        statusEl.style.background = '#e74c3c'; statusEl.textContent = 'Failure';
        resultEl.textContent = 'Error: No file selected.';
        return;
    }

    const formData = new FormData();
    formData.append('file', fileInput.files[0]);
    formData.append('keyId', document.getElementById('fileKeyId').value);
    formData.append('algorithm', document.getElementById('fileAlgorithm').value);

    try {
        const res = await fetch(`/api/encryption/file/${action}`, { method: 'POST', body: formData });
        const data = await res.json();
        
        let downloadHtml = '';
        if (data.outputFileName) {
            downloadHtml = `<a href="/api/encryption/file/download/${data.outputFileName}" target="_blank" class="btn" style="background:#3498db; margin-left:8px; display:inline-block; text-decoration:none; vertical-align:middle;">Download Output File</a>`;
        }

        if (data.success) {
            statusEl.style.background = '#27ae60'; 
            statusEl.innerHTML = `Success — ${data.bytesProcessed} bytes processed ${downloadHtml}`;
        } else {
            statusEl.style.background = '#e74c3c'; 
            statusEl.innerHTML = 'Failure';
        }
        resultEl.innerHTML = renderBeautifulResult(data);
    } catch(e) {
        statusEl.style.background = '#e74c3c'; statusEl.textContent = 'Failure';
        resultEl.textContent = 'Error: ' + e.message;
    }
}
</script>
