@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 1.5rem; align-items: start;">
    <!-- Left Column: Overview and Tools -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="card" style="margin-bottom: 0; padding: 2rem;">
            <span class="eyebrow">OVERVIEW</span>
            <h2 style="margin-bottom: 0.5rem; font-size: 2.2rem;">Dashboard</h2>
            <p class="supporting-text" style="font-size: 0.95rem; margin-bottom: 0;">Welcome to the CADP Integration Lab.</p>
        </div>
        
        <div class="card" style="margin-bottom: 0; padding: 2rem;">
            <h3 style="margin-bottom: 0.5rem;">Quick Actions</h3>
            <p class="supporting-text" style="font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.4;">Jump straight into encryption operations or cryptographic key management.</p>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <a href="/StringEncryption" class="btn" style="background:#0f172a; color:#fff; box-shadow:0 4px 10px rgba(0,0,0,0.1); padding: 10px 18px; font-size: 0.75rem;">String Encryption</a>
                <a href="/FileEncryption" class="btn" style="background:#0f172a; color:#fff; box-shadow:0 4px 10px rgba(0,0,0,0.1); padding: 10px 18px; font-size: 0.75rem;">File Encryption</a>
                <a href="/KmipKeyManagement" class="btn" style="background:#e2e8f0; color:#0f172a; border:1px solid rgba(0,0,0,0.1); box-shadow:none; padding: 10px 18px; font-size: 0.75rem;">Key Management</a>
            </div>
        </div>
    </div>

    <!-- Right Column: Status and Tests -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="card" style="margin-bottom: 0; padding: 2rem;">
            <h3 style="margin-bottom: 1rem;">Platform Health</h3>
            <ul id="health-data" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                <li style="padding: 0.75rem 1rem; background: var(--bg-surface-alt); border-radius: 8px; font-weight:600; border:1px solid rgba(0,0,0,0.08); font-size: 0.9rem;">Loading health data...</li>
            </ul>
        </div>
        
        <div class="card" style="margin-bottom: 0; padding: 2rem;">
            <h3 style="margin-bottom: 1rem;">Diagnostics</h3>
            <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 1rem;">
                <button class="btn" style="font-size: 0.7rem; padding: 10px 14px;" onclick="testCadp()">Test CADP</button>
                <button class="btn" style="font-size: 0.7rem; padding: 10px 14px;" onclick="testKmip()">Test KMIP</button>
                <button class="btn" style="font-size: 0.7rem; padding: 10px 14px;" onclick="testNae()">Test NAE</button>
                <button class="btn" style="font-size: 0.7rem; padding: 10px 14px; background: #16a34a;" onclick="runSmoke()">Smoke Test</button>
            </div>
            <div id="actionStatus" style="padding: 10px 12px; border-radius: 6px; margin-bottom: 8px; font-weight: bold; color: var(--text-muted); font-size: 0.8rem; background: var(--bg-surface-alt); border: 1px solid rgba(0,0,0,0.05);">Status: Ready.</div>
            <div id="actionResult" style="padding: 8px 0; display: none;"></div>
        </div>
    </div>
</div>

<script>
fetch('/health')
    .then(res => res.json())
    .then(data => {
        const renderBadge = (status) => status === 'UP' || status === 'CONFIGURED' 
            ? `<span style="background:#dcfce7; color:#166534; padding:2px 8px; border-radius:12px; font-size:0.65rem; font-weight:700;">${status}</span>`
            : `<span style="background:#fee2e2; color:#991b1b; padding:2px 8px; border-radius:12px; font-size:0.65rem; font-weight:700;">${status}</span>`;
            
        document.getElementById('health-data').innerHTML = `
            <li style="padding:0.6rem 1rem; background:var(--bg-surface); border-radius:6px; display:flex; justify-content:space-between; align-items:center; border:1px solid rgba(0,0,0,0.06); box-shadow:0 1px 2px rgba(0,0,0,0.02); font-size: 0.85rem;"><strong>Application</strong> ${renderBadge(data.application)}</li>
            <li style="padding:0.6rem 1rem; background:var(--bg-surface); border-radius:6px; display:flex; justify-content:space-between; align-items:center; border:1px solid rgba(0,0,0,0.06); box-shadow:0 1px 2px rgba(0,0,0,0.02); font-size: 0.85rem;"><strong>KMIP Link</strong> ${renderBadge(data.kmip)}</li>
            <li style="padding:0.6rem 1rem; background:var(--bg-surface); border-radius:6px; display:flex; justify-content:space-between; align-items:center; border:1px solid rgba(0,0,0,0.06); box-shadow:0 1px 2px rgba(0,0,0,0.02); font-size: 0.85rem;"><strong>NAE-XML Auth</strong> ${renderBadge(data.naeXml)}</li>
            <li style="padding:0.6rem 1rem; background:var(--bg-surface); border-radius:6px; display:flex; justify-content:space-between; align-items:center; border:1px solid rgba(0,0,0,0.06); box-shadow:0 1px 2px rgba(0,0,0,0.02); font-size: 0.85rem;"><strong>CADP Tunnel</strong> ${renderBadge(data.cadp)}</li>
        `;
    });

function setStatus(msg, color, bgColor) {
    const el = document.getElementById('actionStatus');
    el.textContent = msg;
    el.style.color = color;
    el.style.background = bgColor;
    el.style.border = `1px solid ${color}40`;
}

function showResult(data) {
    const el = document.getElementById('actionResult');
    el.style.display = 'block';
    el.innerHTML = renderBeautifulResult(data) || (data.error ? data.error : 'No data');
}

function resetStatus() {
    const el = document.getElementById('actionStatus');
    el.textContent = 'Status: Ready.';
    el.style.color = 'var(--text-muted)';
    el.style.background = 'var(--bg-surface-alt)';
    el.style.border = '1px solid rgba(0,0,0,0.05)';
    document.getElementById('actionResult').style.display = 'none';
}

async function testCadp() {
    setStatus('Testing CADP Encryption...', '#b45309', '#fef3c7');
    try {
        const res = await fetch('/api/encryption/string/encrypt', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ plaintext: 'CADP-connectivity-test', keyId: 'test-key', algorithm: 'AES' })
        });
        const data = await res.json();
        setStatus(data.success ? 'CADP: Connected' : 'CADP: ' + (data.error || 'Failed'), data.success ? '#166534' : '#991b1b', data.success ? '#dcfce7' : '#fee2e2');
        showResult(data);
    } catch (e) {
        setStatus('CADP: Connection Error', '#991b1b', '#fee2e2');
        showResult({ error: e.message });
    }
}

async function testKmip() {
    setStatus('Testing KMIP Connection...', '#b45309', '#fef3c7');
    try {
        const res = await fetch('/api/kmip/test', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({})
        });
        const data = await res.json();
        setStatus(data.success ? 'KMIP: Connected' : 'KMIP: ' + (data.error || 'Failed'), data.success ? '#166534' : '#991b1b', data.success ? '#dcfce7' : '#fee2e2');
        showResult(data);
    } catch (e) {
        setStatus('KMIP: Connection Error', '#991b1b', '#fee2e2');
        showResult({ error: e.message });
    }
}

async function testNae() {
    setStatus('Testing NAE-XML Connection...', '#b45309', '#fef3c7');
    try {
        const res = await fetch('/api/nae/connect', { method: 'POST' });
        const data = await res.json();
        setStatus(data.success ? 'NAE-XML: Connected' : 'NAE-XML: ' + (data.error || 'Failed'), data.success ? '#166534' : '#991b1b', data.success ? '#dcfce7' : '#fee2e2');
        showResult(data);
    } catch (e) {
        setStatus('NAE-XML: Connection Error', '#991b1b', '#fee2e2');
        showResult({ error: e.message });
    }
}

async function runSmoke() {
    setStatus('Running Smoke Tests...', '#b45309', '#fef3c7');
    try {
        const res = await fetch('/api/tests/run-positive', { method: 'POST' });
        const data = await res.json();
        const passed = data.results ? data.results.filter(r => r.passed).length : 0;
        const total = data.results ? data.results.length : 0;
        setStatus(`Smoke Test: ${passed}/${total} passed`, data.success ? '#166534' : '#991b1b', data.success ? '#dcfce7' : '#fee2e2');
        showResult(data);
    } catch (e) {
        setStatus('Smoke Test: Error', '#991b1b', '#fee2e2');
        showResult({ error: e.message });
    }
}
</script>

@functions {
    public class IndexModel : Microsoft.AspNetCore.Mvc.RazorPages.PageModel
    {
        public void OnGet()
        {
        }
    }
}
