@page
@{ ViewData["Title"] = "Test Runner"; }

<div class="card">
    <span class="eyebrow">DIAGNOSTICS</span>
    <h2>Test Runner</h2>
    <p class="supporting-text">Executes automated tests against the CADP API dependencies mapped in this lab environment.</p>
    
    <div style="display: flex; gap: 8px; margin-bottom: 20px;">
        <button class="btn" style="background:#2ecc71;" onclick="runTests('positive')">Run Positive Tests</button>
        <button class="btn" style="background:#e74c3c;" onclick="runTests('negative')">Run Negative Tests</button>
    </div>

    <h3>Test Results: <span id="testStatusGrp" style="padding:4px 8px; font-size:0.6em; border-radius:4px; margin-left:10px; display:none;"></span></h3>
    <table style="width:100%; border-collapse:collapse; margin-top:10px;" id="resultsTable">
        <thead>
            <tr style="background:var(--bg-surface-alt); color:var(--text-primary); border-bottom:1px solid var(--red-line);">
                <th style="padding:8px; text-align:left; width:120px;">Test ID</th>
                <th style="padding:8px; text-align:left; width:150px;">Component</th>
                <th style="padding:8px; text-align:left;">Description</th>
                <th style="padding:8px; text-align:left; width:100px;">Status</th>
                <th style="padding:8px; text-align:left;">Details / Error</th>
            </tr>
        </thead>
        <tbody id="resultsBody">
            <tr style="border-bottom:1px solid #ddd;">
                <td colspan="5" style="padding:8px; text-align:center; color:gray;">Click a button above to run tests...</td>
            </tr>
        </tbody>
    </table>
</div>

<script>
async function runTests(type) {
    const tbody = document.getElementById('resultsBody');
    const statusGrp = document.getElementById('testStatusGrp');
    tbody.innerHTML = '<tr><td colspan="5" style="padding:8px; text-align:center; color:#f39c12;">Running ' + type + ' suite...</td></tr>';
    statusGrp.style.display = 'none';
    
    try {
        const res = await fetch(`/api/tests/run-${type}`, { method: 'POST' });
        const data = await res.json();
        
        statusGrp.style.display = 'inline-block';
        statusGrp.style.background = data.success ? '#27ae60' : '#c0392b';
        statusGrp.style.color = 'white';
        statusGrp.textContent = `Overall: ${data.success ? 'PASS' : 'FAIL'}`;

        tbody.innerHTML = '';
        if (data.results && data.results.length > 0) {
            data.results.forEach(r => {
                const badgeColor = r.passed ? '#27ae60' : '#e74c3c';
                const badgeText = r.passed ? 'PASS' : 'FAIL';
                tbody.innerHTML += `
                <tr style="border-bottom:1px solid #ddd;">
                    <td style="padding:8px; font-family:monospace; font-size:0.85em;">${r.id}</td>
                    <td style="padding:8px;">${r.component}</td>
                    <td style="padding:8px;">${r.description}</td>
                    <td style="padding:8px;">
                        <span style="background:${badgeColor}; color:white; padding:2px 6px; border-radius:3px; font-size:0.8em; font-weight:bold;">${badgeText}</span>
                    </td>
                    <td style="padding:8px; color:gray; font-size:0.9em;">
                        ${r.errorOrDetails || ''}
                    </td>
                </tr>
                `;
            });
        }
    } catch(e) {
        statusGrp.style.display = 'inline-block';
        statusGrp.style.background = '#e74c3c';
        statusGrp.textContent = 'Runner Error';
        tbody.innerHTML = `<tr><td colspan="5" style="padding:8px; color:red;">Error executing test suite: ${e.message}</td></tr>`;
    }
}
</script>
